# WonderBox server environment — TEMPLATE.
#
# Copy to `.env.local` for local dev, and set the same values in Vercel
# (Project Settings -> Environment Variables) for production.
# NEVER commit real values. `.env.local` is gitignored.

# --- Stage 3 (needed now) ------------------------------------------------
# Shared secret so ONLY your device can call /api/ask. Must match DEVICE_TOKEN
# in the firmware's secrets.h. Generate with: openssl rand -hex 32
DEVICE_TOKEN=

# --- Stage 4 (the real pipeline; not needed yet) -------------------------
# OpenAI: speech-to-text + LLM + text-to-speech
# OPENAI_API_KEY=

# Optional: swap TTS to ElevenLabs later (one-line provider change)
# ELEVENLABS_API_KEY=
# TTS_PROVIDER=openai            # openai | elevenlabs

# --- Stage 5 (Supabase logging + config) ---------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Stage 7 (daily digest email) ----------------------------------------
# RESEND_API_KEY=
# DIGEST_TO_EMAIL=
# DIGEST_FROM_EMAIL=
